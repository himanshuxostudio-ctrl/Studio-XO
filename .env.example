# Base URL used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.studioxo.in

# --- Supabase (required — all data and media storage) ---
# Project URL and keys from Supabase → Project Settings → API.
# NEXT_PUBLIC_SUPABASE_URL is safe to expose (it's just the project URL).
NEXT_PUBLIC_SUPABASE_URL=
# Service-role key — full read/write access, bypasses Row Level Security.
# Server-side only, used by lib/supabase.ts. NEVER prefix this with
# NEXT_PUBLIC_, never send it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin authentication (required to use /admin) ---

# Signs admin session cookies. Required for any admin sign-in to work.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# One-time token required to create the first Super Admin account at
# /admin/setup. Set it, complete setup, then you may unset or rotate it —
# the setup page disables itself automatically once an account exists.
ADMIN_SETUP_TOKEN=

# --- Optional: BookMyShow import ---
# No configuration needed — the importer fetches public event pages
# server-side. Left here as a placeholder in case you later swap in a
# licensed data provider / API key.
# BOOKMYSHOW_API_KEY=

# --- Analytics — optional, only loaded (and only after cookie consent) when set ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
